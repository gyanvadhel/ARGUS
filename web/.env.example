NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
ARGUS_API_URL=http://127.0.0.1:8000
# Only for a hosted engine: the ARGUS_API_TOKEN Render generated (leave empty locally)
ARGUS_API_TOKEN=

# Gmail inbox scanning (read-only). Create a Google Cloud OAuth client: see README "Connect Gmail".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GMAIL_TOKEN_KEY=
APP_URL=http://localhost:3000

# Family alerts on Telegram: create a bot with @BotFather and paste its token here.
TELEGRAM_BOT_TOKEN=

# "Continue with Google": set to 1 only after Google sign-in is enabled in Supabase (see AI_HANDOFF.md, §11).
NEXT_PUBLIC_GOOGLE_SIGNIN=
# The sign-in Google client's ID (not secret). With it, Google's screen names this site instead of Supabase.
GOOGLE_SIGNIN_CLIENT_ID=
# Optional key for counting free landing-page checks; falls back to GMAIL_TOKEN_KEY.
RATE_LIMIT_SECRET=
