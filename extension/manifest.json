{
  "manifest_version": 3,
  "name": "Argus",
  "version": "1.0.0",
  "description": "Warns you before phishing and malware pages open, and checks any link in one click.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Argus",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "webNavigation", "tabs", "contextMenus"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*", "https://*.onrender.com/*"],
  "options_page": "options.html"
}
