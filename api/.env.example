# Threat-intel sources (all free tiers). Missing keys just show "Not configured".
VIRUSTOTAL_API_KEY=
GOOGLE_SAFE_BROWSING_KEY=
ABUSECH_AUTH_KEY=
# Security researchers' threat reports on sites and files (free account at otx.alienvault.com)
OTX_API_KEY=
# Abuse reports on the server that sent an email (free account at abuseipdb.com)
ABUSEIPDB_API_KEY=
# Caller ID: spam and fraud reports for numbers worldwide, including India (free account at ipqualityscore.com)
IPQS_API_KEY=
# Region used to read phone numbers without a +country code (US, IN, GB, ...)
ARGUS_DEFAULT_REGION=IN
